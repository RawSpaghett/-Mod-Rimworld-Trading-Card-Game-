<Defs>

<!-- Base -->
<ThingDef Name="RTCG_Base" Abstract="True">
        <thingClass>Apparel</thingClass> 
        <category>Item</category>
        <altitudeLayer>Item</altitudeLayer>
        <thingCategories>
            <li>RTCG</li> 
            <li> RTCGBaseSet </li>
        </thingCategories>
        <!--<equippedStatOffsets> -->
        <statBases>
            <MaxHitPoints>20</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <DeteriorationRate>1</DeteriorationRate>
            <SellPriceFactor>0.5</SellPriceFactor>
            <Mass>0.1</Mass> 
            <!--
            <marketValue>10</marketValue>
		    <Beauty>8</Beauty>
            -->
        </statBases>
		<useHitPoints>True</useHitPoints>
        <selectable>True</selectable>
        <alwaysHaulable>True</alwaysHaulable>
        <neverMultiSelect>True</neverMultiSelect>
        <!-- <techLevel>Midworld</techLevel> -->
        <drawGUIOverlay>true</drawGUIOverlay>
		<stackLimit>1</stackLimit>
		<tradeNeverStack>true</tradeNeverStack>
        <!-- <generateCommonality> </generateCommonality> -->
        <tradeTags> <li> BulkGoods </li> <li> ExoticMisc </li> </tradeTags>
       <!-- <graphicData>
            <texPath>TEXTUREHERE</texPath>
      		<graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        -->

		<soundInteract>Standard_Drop</soundInteract>
    	<soundDrop>Standard_Drop</soundDrop>
        <apparel>
            <careIfWornByCorpse>false</careIfWornByCorpse>
            <careIfDamageResult>false</careIfDamageResult>
            <bodyPartGroups>
                <li>Waist</li>
            </bodyPartGroups>
            <layers>
                <li>Belt</li>
            </layers>
            <!--<tags> ADD TAGS FOR RAIDER APPAREL BUDGET </tags> -->
        </apparel>
    </ThingDef>

